# ========================
# CodeMentor Environment
# ========================

# Database
DATABASE_URL=postgresql+asyncpg://codementor:codementor_dev_password@localhost:5432/codementor
DATABASE_URL_SYNC=postgresql://codementor:codementor_dev_password@localhost:5432/codementor

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Code Execution (Judge0)
# Option 1: RapidAPI (cloud)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key-here
# Option 2: Self-hosted
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=

# AI Provider (choose one)
AI_PROVIDER=openai  # openai | gemini | anthropic

# OpenAI
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-pro

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# App
APP_NAME=CodeMentor
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@codementor.dev
