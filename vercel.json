{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://codementor-m7lo.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://codementor-m7lo.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
